{
  "name": "dh-cs",
  "version": "0.1.0",
  "private": true,
  "description": "Character Codex - A mobile-first digital character sheet for the Daggerheart TTRPG",
  "author": "Alex <galactic.eye.codex@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/galacticeyecodex-debug/dh-cs.git"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "enhance-json": "npx tsx scripts/enhance_json.ts",
    "seed:public": "node content/public/seed-public-library.js",
    "seed:private": "node content/private/seed-private-library.js",
    "db:seed": "node scripts/db-seed.js",
    "hooks:install": "bash scripts/install-hooks.sh",
    "e2e": "playwright test --project=chromium",
    "e2e:all": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed --project=chromium",
    "e2e:mobile": "playwright test --project=mobile",
    "e2e:tablet": "playwright test --project=tablet",
    "e2e:screenshot": "playwright test e2e/visual-check.spec.ts --project=chromium",
    "e2e:update-snapshots": "playwright test --update-snapshots --project=chromium",
    "e2e:debug": "playwright test --debug --project=chromium"
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "lodash": "^4.17.23",
    "lucide-react": "^0.562.0",
    "next": "^15.5.9",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.2.5",
    "vaul": "^1.1.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.17.23",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.3.0",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "5.9.3",
    "vitest": "^4.0.16"
  }
}

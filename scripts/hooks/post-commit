#!/bin/bash
#
# post-commit hook: upload seed SQL to Supabase when enhanced JSON was committed
#
# Triggers when any *_enhanced.json file was included in the last commit.
# Runs npm run db:seed to push the regenerated SQL to the remote database.
#
# Requires SUPABASE_ACCESS_TOKEN in .env.local.
# Skipped silently if the token is not set.
#
# Install: npm run hooks:install
# Source:  scripts/hooks/post-commit (checked in)

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Check if the last commit touched any enhanced JSON files
COMMITTED_ENHANCED=$(git diff-tree --no-commit-id -r --name-only HEAD | grep 'content/.*_enhanced\.json' || true)

if [ -z "$COMMITTED_ENHANCED" ]; then
  exit 0
fi

# Check if SUPABASE_ACCESS_TOKEN is set (load from .env.local if present)
ENV_FILE="$REPO_ROOT/.env.local"
if [ -f "$ENV_FILE" ]; then
  TOKEN=$(grep -E '^SUPABASE_ACCESS_TOKEN=' "$ENV_FILE" | cut -d '=' -f2- | tr -d '"' | tr -d "'")
fi

if [ -z "$TOKEN" ]; then
  echo ""
  echo "⚠️  Skipping db:seed — SUPABASE_ACCESS_TOKEN not set in .env.local"
  echo "    Run manually: npm run db:seed"
  echo ""
  exit 0
fi

echo ""
echo "🚀 Enhanced JSON committed — uploading seed to Supabase..."
echo ""

(cd "$REPO_ROOT" && npm run db:seed)

echo ""
